EXTERNAL TutorialShot(name, seconds)
EXTERNAL TutorialCaption(heading, body)
EXTERNAL TutorialDemo(action, seconds)
EXTERNAL Wait(seconds)

~ TutorialShot("conveyor", 0.0)
~ TutorialCaption("Guide to the Ghost", "")
~ Wait(4.0)
~ TutorialCaption("Open A Package", "Fly: WASD / arrows / stick. Conveyor packages: E / gamepad X.")
~ TutorialDemo("ghost-fly", 3.0)
~ TutorialShot("conveyor", 1.0)
~ TutorialDemo("package", 3.0)
~ TutorialShot("floor", 1.0)
~ TutorialCaption("Place", "Clear of fish and traps. E / X places. No placement or cart travel in starting hallway.")
~ TutorialDemo("carry", 3.0)
~ TutorialShot("safe", 1.0)
~ TutorialDemo("invalid", 4.0)
~ TutorialShot("floor", 1.0)
~ TutorialDemo("place", 2.0)
~ TutorialCaption("Possess", "Beside traps, E / X: possess / release.")
~ TutorialDemo("possess", 2.0)
~ TutorialCaption("Read The Danger Bands", "Ghost markers bound the animated ghost-fish danger band.")
~ TutorialDemo("danger-band", 2.0)
~ TutorialCaption("Tablecart", "A / D / stick: drive. Knockback, piranha stun, recovery. No health loss.")
~ TutorialDemo("cart-move", 2.0)
~ TutorialShot("trap-wide", 1.0)
~ TutorialDemo("tablecart-hit", 5.0)
~ TutorialDemo("unpossess", 2.0)
~ TutorialShot("ceiling", 1.0)
~ TutorialCaption("Swinging Chandelier", "Mouse: clear ceiling within reach. E / X places; base stays fixed.")
~ TutorialDemo("chandelier", 3.0)
~ TutorialDemo("chandelier-sway", 3.0)
~ TutorialCaption("Drop It", "Space / gamepad A: drop.")
~ TutorialDemo("fall", 2.5)
~ TutorialCaption("Reset", "F / gamepad B: reset when clear.")
~ TutorialDemo("reset", 2.5)
~ TutorialShot("click", 1.0)
~ TutorialCaption("Click Trap", "Possess; click its body. It stays still.")
~ TutorialDemo("click", 2.5)
~ TutorialCaption("Dispose", "Q discards your held or possessed trap.")
~ TutorialDemo("dispose", 2.0)
~ TutorialShot("trap-wide", 1.0)
~ TutorialCaption("Angler", "Rushes horizontally, killing every crossed fish; slows inside bodies.")
~ TutorialDemo("angler-place", 1.0)
~ TutorialCaption("Possess The Angler", "A / D / stick: steer. Possession lights it; release extinguishes.")
~ TutorialDemo("angler-light", 3.0)
~ TutorialDemo("angler-sweep", 3.5)
~ TutorialCaption("Wowza", "Damaging traps drain health. Bodies remain; souls rise. Dead fish spectate.")
~ Wait(3.5)
~ TutorialCaption("Ready And Setup", "Everyone: role page, Ready. 10-second setup, then fish move.")
~ Wait(5.0)
-> END
