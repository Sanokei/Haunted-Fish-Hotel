EXTERNAL TutorialShot(name, seconds)
EXTERNAL TutorialCaption(heading, body)
EXTERNAL TutorialDemo(action, seconds)
EXTERNAL Wait(seconds)

~ TutorialShot("conveyor", 0.0)
~ TutorialCaption("You Are The Ghost", "Use traps to spook the fish. Packages arrive on the conveyor above the hallway.")
~ Wait(4.0)
~ TutorialCaption("Fly", "WASD or arrow keys flies in two dimensions. Gamepad: left stick.")
~ TutorialDemo("ghost-fly", 3.0)
~ TutorialShot("conveyor", 1.0)
~ TutorialCaption("Open A Package", "Fly close to a package and press E. Gamepad: X. You now carry its trap.")
~ TutorialDemo("package", 3.0)
~ TutorialShot("floor", 1.0)
~ TutorialCaption("Carry It To The Hallway", "Fly down to a clear floor space. You cannot place over another trap or a fish.")
~ TutorialDemo("carry", 3.0)
~ TutorialShot("safe", 1.0)
~ TutorialCaption("The Safe Hallway", "The starting hallway forbids trap footprints and cart travel.")
~ TutorialDemo("invalid", 4.0)
~ TutorialShot("floor", 1.0)
~ TutorialCaption("Place", "With a valid floor preview, press E / X to place the held trap.")
~ TutorialDemo("place", 2.0)
~ TutorialCaption("Possess", "Fly near your placed trap and press E / X to control it.")
~ TutorialDemo("possess", 2.0)
~ TutorialCaption("Shopping Cart", "While possessed, A / D or left stick moves the cart. It collides with the real hallway and bodies.")
~ TutorialDemo("cart-move", 2.0)
~ TutorialCaption("Unpossess", "E / X releases control so you can fly again.")
~ TutorialDemo("unpossess", 2.0)
~ TutorialShot("ceiling", 1.0)
~ TutorialCaption("Falling Chandelier", "Carry a chandelier. Aim at a clear ceiling position with the mouse within reach, then E / X places it.")
~ TutorialDemo("chandelier", 3.0)
~ TutorialCaption("Drop It", "Possess the chandelier, then press Space. Gamepad: A. Time the drop as a fish passes.")
~ TutorialDemo("fall", 2.5)
~ TutorialCaption("Reset", "F resets a controlled trap if its reset position is clear. Gamepad: B.")
~ TutorialDemo("reset", 2.5)
~ TutorialShot("click", 1.0)
~ TutorialCaption("Click Trap", "Possess the stationary click trap. Click its body to activate it; it does not drive like the cart.")
~ TutorialDemo("click", 2.5)
~ TutorialCaption("Dispose", "Q discards a held trap or removes the trap you are currently possessing.")
~ TutorialDemo("dispose", 2.0)
~ TutorialCaption("Spook And Role Swap", "Moving or active traps raise spook on contact. At 100, the fish becomes the ghost and you take its fish body.")
~ Wait(5.5)
~ TutorialCaption("Ready And Setup", "Choose Ready on your role page. Once everyone is ready, use your 10-second setup before the fish is released.")
~ Wait(5.0)
-> END
