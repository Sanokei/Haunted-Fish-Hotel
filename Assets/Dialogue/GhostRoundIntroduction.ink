// Server chooses the outcome; every client completes this sequence before ready-up.
EXTERNAL DollyTo(tag, amount, seconds)
EXTERNAL ParallaxTo(rig, pose, seconds, easing)
EXTERNAL Knock(tag, count, interval)
EXTERNAL Wait(seconds)
EXTERNAL SetVisible(tag, visible)
EXTERNAL FlashFrames(frames)
~ DollyTo("wheel_spin", 1.0, 7.0)
~ Knock("selected_slice", 3, 0.4)
~ Wait(0.8)
~ SetVisible("attic_cutscene", true)
~ Wait(1.4)
~ ParallaxTo("hotel_camera", "attic_top", 4.0, "smooth")
~ SetVisible("ghost", true)
~ Knock("ghost", 1, 0.5)
~ Wait(1.5)
~ SetVisible("upward_streaks", true)
~ SetVisible("return_blur", true)
~ ParallaxTo("hotel_camera", "hotel_bottom", 0.45, "ease_in")
// Cover the instantaneous cut; the same authored hallway and fish remain in place.
~ SetVisible("transition_flash", true)
~ SetVisible("return_blur", false)
~ SetVisible("upward_streaks", false)
~ SetVisible("ghost", false)
~ ParallaxTo("hotel_camera", "hallway_end", 0.0, "linear")
~ FlashFrames(2)
~ Wait(0.7)
// Blur is a separate Ink-controlled effect, used only during this camera move.
~ SetVisible("hallway_blur", true)
~ ParallaxTo("hotel_camera", "hallway_start", 0.85, "smooth")
~ SetVisible("hallway_blur", false)
~ Wait(1.0)
-> END
