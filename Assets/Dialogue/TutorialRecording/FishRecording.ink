EXTERNAL TutorialShot(name, seconds)
EXTERNAL TutorialCaption(heading, body)
EXTERNAL TutorialDemo(action, seconds)
EXTERNAL TutorialSetup(action, seconds)
EXTERNAL Wait(seconds)

~ TutorialShot("fish-wide", 0.0)
~ TutorialCaption("Guide to all Fish", "")
~ Wait(4.0)
~ TutorialCaption("A Gentleman Walks", "A / D walk. Shift runs, as if late. Pad: stick walks, click runs.")
~ TutorialDemo("fish-walk", 3.0)
~ TutorialShot("fish-run", 1.0)
~ TutorialDemo("fish-run", 2.0)
~ TutorialShot("fish-wide", 1.0)
~ TutorialCaption("The Heroic Leap", "Space / gamepad A jumps. Hold run to clear carts.")
~ TutorialDemo("fish-jump", 3.0)
~ TutorialSetup("jump-setup", 1.2)
~ TutorialDemo("fish-obstacle", 1.6)
~ TutorialShot("trap-wide", 1.0)
~ TutorialCaption("Dining cart", "Dinner, served fast. Knockback and stun; health survives, dignity does not.")
~ TutorialDemo("tablecart-hit", 5.0)
~ TutorialCaption("Read The Danger Bands", "Ghost markers frame a snapping fish. Stay out of the band.")
~ TutorialDemo("danger-band", 2.0)
~ TutorialCaption("Something Is Watching", "Mouse aims your spotlight. Check floor and ceiling. Especially ceiling.")
~ TutorialDemo("fish-light", 5.0)
~ TutorialShot("door", 1.0)
~ TutorialCaption("The Stairwell", "Reach it; E / gamepad X starts the challenge. Escape is upstairs.")
~ Wait(5.0)
~ TutorialShot("ceiling", 1.0)
~ TutorialCaption("Swinging Chandelier", "Fixed base, swinging body. Possession drops it. Never loiter beneath fancy.")
~ TutorialDemo("chandelier-sway", 3.0)
~ TutorialDemo("fall", 2.5)
~ TutorialShot("trap-wide", 1.0)
~ TutorialCaption("Angler", "Charges sideways, kills fish it crosses, slows inside bodies. Possession lights it.")
~ TutorialDemo("angler-place", 1.0)
~ TutorialDemo("angler-light", 3.0)
~ TutorialDemo("angler-sweep", 3.5)
~ TutorialCaption("Wowza", "Traps drain health. Souls rise; dead fish spectate. No refunds.")
~ Wait(3.5)
~ TutorialCaption("Ready For The Round", "Everyone: role page, Ready. Ghost sets up 10 seconds. Curtain up.")
~ Wait(6.0)
-> END
