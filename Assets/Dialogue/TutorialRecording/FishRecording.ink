EXTERNAL TutorialShot(name, seconds)
EXTERNAL TutorialCaption(heading, body)
EXTERNAL TutorialDemo(action, seconds)
EXTERNAL TutorialSetup(action, seconds)
EXTERNAL Wait(seconds)

~ TutorialShot("fish-wide", 0.0)
~ TutorialCaption("Guide to all Fish", "")
~ Wait(4.0)
~ TutorialCaption("Move", "A / D / arrows: walk. Shift: run. Gamepad: stick walks; click runs.")
~ TutorialDemo("fish-walk", 3.0)
~ TutorialShot("fish-run", 1.0)
~ TutorialDemo("fish-run", 2.0)
~ TutorialShot("fish-wide", 1.0)
~ TutorialCaption("Jump", "Space / gamepad A: jump. Hold run and direction while jumping over carts.")
~ TutorialDemo("fish-jump", 3.0)
~ TutorialSetup("jump-setup", 1.2)
~ TutorialDemo("fish-obstacle", 1.6)
~ TutorialShot("trap-wide", 1.0)
~ TutorialCaption("Dining cart", "Knockback and piranha stun. Recover with health unchanged.")
~ TutorialDemo("tablecart-hit", 5.0)
~ TutorialCaption("Read The Danger Bands", "Ghost markers bound the animated ghost-fish danger band.")
~ TutorialDemo("danger-band", 2.0)
~ TutorialCaption("Look Into The Dark", "Mouse: aim your spotlight. Check floor and ceiling.")
~ TutorialDemo("fish-light", 5.0)
~ TutorialShot("door", 1.0)
~ TutorialCaption("The Stairwell", "Reach the stairwell. E / gamepad X starts the challenge.")
~ Wait(5.0)
~ TutorialShot("ceiling", 1.0)
~ TutorialCaption("Swinging Chandelier", "Fixed base, swinging body. Possession lets it drop.")
~ TutorialDemo("chandelier-sway", 3.0)
~ TutorialDemo("fall", 2.5)
~ TutorialShot("trap-wide", 1.0)
~ TutorialCaption("Angler", "Rushes horizontally, killing every crossed fish; slows inside bodies. Possession lights it.")
~ TutorialDemo("angler-place", 1.0)
~ TutorialDemo("angler-light", 3.0)
~ TutorialDemo("angler-sweep", 3.5)
~ TutorialCaption("Wowza", "Damaging traps drain health. Bodies remain; souls rise. Dead fish spectate.")
~ Wait(3.5)
~ TutorialCaption("Ready For The Round", "Everyone: role page, Ready. Ghost: 10 seconds before fish move.")
~ Wait(6.0)
-> END
