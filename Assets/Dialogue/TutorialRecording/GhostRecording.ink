EXTERNAL TutorialShot(name, seconds)
EXTERNAL TutorialCaption(heading, body)
EXTERNAL TutorialDemo(action, seconds)
EXTERNAL Wait(seconds)

~ TutorialShot("conveyor", 0.0)
~ TutorialCaption("Guide to the Ghost", "")
~ Wait(4.0)
~ TutorialCaption("Open A Package", "Fly: WASD / arrows / stick. Packages: E / gamepad X.")
~ TutorialDemo("ghost-fly", 3.0)
~ TutorialShot("conveyor", 1.0)
~ TutorialDemo("package", 3.0)
~ TutorialShot("floor", 1.0)
~ TutorialCaption("Place, Politely", "Clear of fish, traps, starting hallway. E / X places.")
~ TutorialDemo("carry", 3.0)
~ TutorialShot("safe", 1.0)
~ TutorialDemo("invalid", 4.0)
~ TutorialShot("floor", 1.0)
~ TutorialDemo("place", 2.0)
~ TutorialCaption("Possess", "Beside a trap, E / X possesses or releases it.")
~ TutorialDemo("possess", 2.0)
~ TutorialCaption("Read The Danger Bands", "Your markers frame the danger band. Fair as falling pianos.")
~ TutorialDemo("danger-band", 2.0)
~ TutorialCaption("Dining cart", "A / D / stick drives. Knockback, stun, no health loss.")
~ TutorialDemo("cart-move", 2.0)
~ TutorialShot("trap-wide", 1.0)
~ TutorialDemo("tablecart-hit", 5.0)
~ TutorialDemo("unpossess", 2.0)
~ TutorialShot("ceiling", 1.0)
~ TutorialCaption("Swinging Chandelier", "Clear ceiling, E / X places. Base fixed, body swings.")
~ TutorialDemo("chandelier", 3.0)
~ TutorialDemo("chandelier-sway", 3.0)
~ TutorialCaption("Drop It", "Space / A drops it. Gravity does the acting.")
~ TutorialDemo("fall", 2.5)
~ TutorialCaption("Dispose", "Q discards held or possessed traps. Out with old gags!")
~ TutorialDemo("dispose", 2.0)
~ TutorialShot("trap-wide", 1.0)
~ TutorialCaption("Angler", "Charges sideways, kills every fish crossed, slows inside bodies.")
~ TutorialDemo("angler-place", 1.0)
~ TutorialCaption("Possess The Angler", "A / D / stick steers. Possession lights it.")
~ TutorialDemo("angler-light", 3.0)
~ TutorialDemo("angler-sweep", 3.5)
~ TutorialCaption("Wowza", "Traps drain health. Souls rise; dead fish spectate.")
~ Wait(3.5)
~ TutorialCaption("Ready And Setup", "Role page, Ready. Ten seconds setup, then fish move.")
~ Wait(5.0)
-> END
