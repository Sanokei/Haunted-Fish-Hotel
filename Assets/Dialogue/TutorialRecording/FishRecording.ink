EXTERNAL TutorialShot(name, seconds)
EXTERNAL TutorialCaption(heading, body)
EXTERNAL TutorialDemo(action, seconds)
EXTERNAL Wait(seconds)

~ TutorialShot("fish-wide", 0.0)
~ TutorialCaption("You Are The Fish", "Reach the stairwell while avoiding the ghost's traps.")
~ Wait(4.0)
~ TutorialCaption("Move", "A / D or arrow keys walk. Gamepad: left stick.")
~ TutorialDemo("fish-walk", 3.0)
~ TutorialShot("fish-run", 1.0)
~ TutorialCaption("Run", "Hold Shift to run. Gamepad: click the left stick.")
~ TutorialDemo("fish-run", 2.0)
~ TutorialShot("fish-wide", 1.0)
~ TutorialCaption("Jump", "Space jumps from the ground. Gamepad: A.")
~ TutorialDemo("fish-jump", 3.0)
~ TutorialCaption("Clear The Traps", "Run and jump over obstacles. A cart can move; a chandelier can fall.")
~ TutorialDemo("fish-obstacle", 3.5)
~ TutorialCaption("Look Into The Dark", "Move your mouse to aim the spotlight. Watch the floor and ceiling.")
~ TutorialDemo("fish-light", 5.0)
~ TutorialShot("door", 1.0)
~ TutorialCaption("The Stairwell", "Reach the door, then press E. Gamepad: X. This starts the ghost challenge.")
~ Wait(5.0)
~ TutorialCaption("Watch Your Spook", "Moving or active traps raise spook on contact. At 100, you become the ghost; the old ghost takes your fish body.")
~ Wait(6.0)
~ TutorialCaption("Ready For The Round", "Read your role page and choose Ready. Everyone must be ready, then the ghost has a 10-second setup before you move.")
~ Wait(6.0)
-> END
